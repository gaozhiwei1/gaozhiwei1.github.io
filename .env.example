# Browser-safe values. These are intentionally embedded in the Vite bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_GOOGLE_AUTH=false
VITE_ENABLE_GITHUB_AUTH=false

# Server-only Supabase credentials. Never prefix the service key with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe TEST MODE only during development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=

# Display metadata, in fen (CNY). Stripe remains the billing source of truth.
PRO_MONTHLY_PRICE_CNY=12900
PRO_ANNUAL_PRICE_CNY=99900

# Trusted server-generated redirect base. Do not accept this from the browser.
APP_BASE_URL=http://127.0.0.1:4173
HOST=127.0.0.1
PORT=4173
